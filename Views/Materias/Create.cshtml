@model ColegioSanJoseWeb.Models.Materia

<h2>Nueva Materia</h2>

<form asp-action="Create">
    <div class="form-group">
        <label asp-for="NombreMateria"></label>
        <input asp-for="NombreMateria" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Docente"></label>
        <input asp-for="Docente" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success mt-2">Guardar</button>
    <a href="/Materias" class="btn btn-secondary mt-2">Cancelar</a>
</form>